{
  "name": "@villa-platform/root",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml}\"",
    "db:generate": "pnpm --filter @villa-platform/database db:generate",
    "db:migrate": "pnpm --filter @villa-platform/database db:migrate",
    "db:seed": "pnpm --filter @villa-platform/database db:seed",
    "test:load": "k6 run infrastructure/performance/booking-spike.js",
    "prr": "tsx scripts/prr.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autocannon": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "hono": "^4.6.4",
    "jose": "^5.2.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "firebase": "^12.18.0"
  }
}